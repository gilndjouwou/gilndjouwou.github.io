---
import { render } from 'astro:content';
import NoteLayout from '@/layouts/NoteLayout.astro';
import { CATEGORY_SLUGS } from '@/lib/categories';
import { getNotes } from '@/lib/notes';
import { getReadingTime } from '@/lib/reading-time';

export async function getStaticPaths() {
  const entriesByCategory = await Promise.all(
    CATEGORY_SLUGS.map(async (category) => [category, await getNotes(category)] as const),
  );

  return entriesByCategory.flatMap(([category, entries]) =>
    entries.map((note, index) => ({
      params: { category, slug: note.id },
      props: {
        note,
        prev: entries[index - 1],
        next: entries[index + 1],
      },
    })),
  );
}

const { note, prev, next } = Astro.props;
const { Content } = await render(note);
const readingTime = note.data.category === 'blog' ? getReadingTime(note.body) : undefined;
---

<NoteLayout frontmatter={note.data} image={`/og/${note.id}.png`} {prev} {next} {readingTime}>
  <Content />
</NoteLayout>
