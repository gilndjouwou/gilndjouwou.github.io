---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Intro from '@/components/Intro.astro';
import Footer from '@/components/Footer.astro';
import { SITE_TITLE } from '@/consts';
import { CATEGORIES } from '@/lib/categories';
import { getNotes } from '@/lib/notes';

const categories = await Promise.all(
  CATEGORIES.map(async (category) => ({
    ...category,
    entries: await getNotes(category.slug),
  })),
);
---

<BaseLayout title={SITE_TITLE} headProps={{ image: '/og/index.png' }}>
  <Intro />

  <section aria-label="Portfolio categories">
    <ul class="categories">
      {categories.map(({ slug, title, entries }) => (
        <li>
          <a href={`/${slug}/`}>{title}</a>
          {entries.length > 0 && (
            <ul class="entries">
              {entries.map((entry) => (
                <li>
                  <a href={`/${slug}/${entry.id}/`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  section {
    margin-top: 3em;
  }

  .categories {
    display: grid;
    gap: 1.25em;
    padding: 0;
    list-style: none;
  }

  .entries {
    display: grid;
    gap: 0.25em;
    padding-inline-start: 2ch;
    margin-top: 0.35em;
    list-style: none;
  }
</style>
