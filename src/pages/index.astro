---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Intro from '@/components/Intro.astro';
import Footer from '@/components/Footer.astro';
import { SITE_TITLE } from '@/consts';
import { CATEGORIES, type CategorySlug } from '@/lib/categories';
import { formatBlogMonthYear } from '@/lib/date';
import { getNotes } from '@/lib/notes';

const previewImages = import.meta.glob<ImageMetadata>(
  '/src/content/notes/assets/**/*.{avif,gif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
);

const categories = await Promise.all(
  CATEGORIES.map(async (category) => ({
    ...category,
    entries: await getNotes(category.slug),
  })),
);

function getHomeEntries(slug: CategorySlug, entries: Awaited<ReturnType<typeof getNotes>>) {
  if (slug !== 'blog') return entries;

  return entries
    .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);
}
---

<BaseLayout title={SITE_TITLE} headProps={{ image: '/og/index.png' }}>
  <Intro />

  <section aria-label="Categories">
    <ul class="categories">
      {categories.map(({ slug, title, entries }) => (
        <li>
          <a href={`/${slug}/`}>{title}</a>
          {entries.length > 0 && (
            <>
              <ul class={slug === 'blog' ? 'entries blog-entries' : 'entries'}>
                {getHomeEntries(slug, entries).map((entry) => (
                  <li class={slug === 'blog' ? 'blog-entry' : undefined}>
                    {slug === 'blog' && (
                      <time datetime={entry.data.pubDate.toISOString()}>
                        {formatBlogMonthYear(entry.data.pubDate)}
                      </time>
                    )}
                    <a class="entry-link" href={`/${slug}/${entry.id}/`}>
                      {entry.data.title}
                      {entry.data.previewImage &&
                        previewImages[
                          `/src/content/notes/${entry.data.previewImage.replace(/^\.\//, '')}`
                        ] && (
                        <Image
                          class="entry-preview"
                          src={
                            previewImages[
                              `/src/content/notes/${entry.data.previewImage.replace(/^\.\//, '')}`
                            ]
                          }
                          alt=""
                          width={640}
                          format="webp"
                          loading="eager"
                          decoding="async"
                        />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
              {slug === 'blog' && (
                <a class="view-more" href="/blog/">view more</a>
              )}
            </>
          )}
        </li>
      ))}
    </ul>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  section {
    margin-top: 3em;
  }

  .categories {
    display: grid;
    gap: 1.25em;
    padding: 0;
    list-style: none;
  }

  .entries {
    display: grid;
    gap: 0.25em;
    padding-inline-start: 2ch;
    margin-top: 0.35em;
    list-style: none;
  }

  .blog-entry {
    display: grid;
    grid-template-columns: 7ch 1fr;
    column-gap: 1ch;
    align-items: baseline;
  }

  .blog-entry time {
    color: var(--theme-sub-text);
    font-size: 0.9em;
    text-align: right;
  }

  .view-more {
    display: inline-block;
    margin: 0.5em 0 0 2ch;
  }

  .entry-preview {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 1000px) {
    .entry-preview {
      position: fixed;
      top: 50%;
      left: calc(60em + 2rem);
      width: min(32vw, 420px, calc(100vw - 60em - 5rem));
      height: auto;
      max-height: 72vh;
      object-fit: contain;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-50%);
      transition: opacity 150ms ease;
      z-index: 1;
    }

    .entry-link:hover .entry-preview,
    .entry-link:focus-visible .entry-preview {
      display: block;
      opacity: 1;
    }
  }
</style>
