---
import { CATEGORY_LABELS } from '@/lib/categories';
import type { CategorySlug } from '@/lib/categories';
import { formatDate } from '@/lib/date';

interface Props {
  title: string;
  category: CategorySlug;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, category, pubDate, updatedDate } = Astro.props;
---

<header>
  <p class="meta">
    <a href={`/${category}/`}>{CATEGORY_LABELS[category]}</a>
    <span aria-hidden="true"> / </span>
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </p>
  <h1>{title}</h1>
  {updatedDate && <p class="updated">Updated {formatDate(updatedDate)}</p>}
</header>

<style>
  header {
    margin-bottom: 2em;
  }

  h1 {
    margin-top: 0.5em;
    font-size: 1.5em;
  }

  .meta,
  .updated {
    color: var(--theme-sub-text);
  }

  .updated {
    margin-top: 0.5em;
    font-size: 0.9em;
  }
</style>
