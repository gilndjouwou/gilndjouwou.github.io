---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string; preserveAnimation?: boolean }[];
}

const { images } = Astro.props;
const galleryImages = await Promise.all(
  images.map(async ({ src, alt, preserveAnimation }) => {
    if (preserveAnimation) {
      return {
        thumbnail: src.src,
        width: src.width,
        height: src.height,
        fullSize: src.src,
        alt,
      };
    }

    const [thumbnail, fullSize] = await Promise.all([
      getImage({ src, width: 1200, format: 'webp' }),
      getImage({ src, format: 'webp' }),
    ]);

    return {
      thumbnail: thumbnail.src,
      width: thumbnail.attributes.width,
      height: thumbnail.attributes.height,
      fullSize: fullSize.src,
      alt,
    };
  }),
);
---

<div class="photo-gallery" data-photo-gallery>
  <div class="gallery">
    {galleryImages.map(({ thumbnail, width, height, fullSize, alt }) => (
      <figure>
        <a
          href={fullSize}
          class="thumbnail"
          data-full-image={fullSize}
          data-full-alt={alt}
          aria-label={`View ${alt} full size`}
        >
          <img src={thumbnail} {width} {height} {alt} loading="lazy" decoding="async" />
        </a>
      </figure>
    ))}
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="close" type="button" aria-label="Close image">×</button>
    <img class="full-image" alt="" />
  </dialog>
</div>

<script>
  document.querySelectorAll('[data-photo-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector('dialog');
    const image = dialog?.querySelector('.full-image');
    const closeButton = dialog?.querySelector('.close');

    if (!(dialog instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement) || !(closeButton instanceof HTMLButtonElement)) {
      throw new Error('Photo gallery lightbox markup is incomplete.');
    }

    gallery.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest('a[data-full-image]');
      if (!(link instanceof HTMLAnchorElement) || !gallery.contains(link)) return;

      const fullImage = link.getAttribute('data-full-image');
      const alt = link.getAttribute('data-full-alt');
      if (!fullImage || alt === null) {
        throw new Error('Photo gallery image is missing its full-size source or alt text.');
      }

      event.preventDefault();
      image.src = fullImage;
      image.alt = alt;
      dialog.showModal();
      closeButton.focus();
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
      }
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      image.alt = '';
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2em;
  }

  figure {
    margin: 0;
  }

  .thumbnail {
    display: block;
    cursor: zoom-in;
  }

  .thumbnail:focus-visible {
    outline: 2px solid var(--theme-text);
    outline-offset: 4px;
  }

  .thumbnail img {
    display: block;
    width: 100%;
    height: auto;
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 3vw, 3rem);
    border: 0;
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.94);
  }

  .full-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .close {
    position: fixed;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    border: 0;
    padding: 0.25em 0.5em;
    background: transparent;
    color: white;
    font: inherit;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

</style>
