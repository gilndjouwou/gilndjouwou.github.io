---
import { LINKS } from '@/consts';
import HomeClock from '@/components/HomeClock.astro';

const isContact = (href: string) => /^(mailto|tel):/.test(href);
const { showClock = false } = Astro.props;
---

<footer>
  <span>
    [↗]: {LINKS.map(({ label, href }) => (
      <><a
        target={isContact(href) ? undefined : '_blank'}
        rel={isContact(href) ? undefined : 'me'}
        href={href}
        data-obfuscation={isContact(href) ? '1' : undefined}
      >{label}</a>, </>
    ))}<a href="https://drive.google.com/file/d/1dd14OQe6pr84IlgzCtlSx3Xcdj0mdo_m/view?usp=sharing" target="_blank" rel="noopener noreferrer">Resume (PDF)</a>
  </span>
  {showClock && <HomeClock />}
</footer>

<style>
  footer {
    position: relative;

    padding-top: 1em;
    margin-top: 3em;
  }

  span {
    color: var(--theme-sub-text);
  }

  footer::before {
    content: '';
    position: absolute;

    top: 0;
    width: 25%;

    border-top: 1px solid var(--theme-sub-text);
  }
</style>