---
export interface Props {
  provider: 'youtube' | 'vimeo' | 'instagram';
  id: string;
  title: string;
}

const { provider, id, title } = Astro.props;

const patterns = {
  youtube: /^[\w-]{11}$/,
  vimeo: /^\d+$/,
  instagram: /^(?:(?:p|reel|tv)\/)?[A-Za-z0-9_-]+$/,
};

if (!patterns[provider].test(id)) {
  throw new Error(`Invalid ${provider} embed ID: ${id}`);
}

const instagramMatch = provider === 'instagram' ? id.match(/^(?:(p|reel|tv)\/)?([A-Za-z0-9_-]+)$/) : undefined;
const src = {
  youtube: `https://www.youtube-nocookie.com/embed/${id}`,
  vimeo: `https://player.vimeo.com/video/${id}`,
  instagram: `https://www.instagram.com/${instagramMatch?.[1] ?? 'p'}/${instagramMatch?.[2]}/embed/`,
}[provider];
---

<div class:list={['embed', provider]}>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<style>
  .embed {
    width: 100%;
    margin-block: 1.5em;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--theme-code-block);
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .instagram {
    max-width: 540px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }
</style>
