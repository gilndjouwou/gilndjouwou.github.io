---
import Portrait from '@/components/Portrait.astro';
import { CATEGORIES } from '@/lib/categories';
import { PORTRAIT, SITE_TITLE } from '@/consts';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<header>
  {title === SITE_TITLE && PORTRAIT ? (
    <h1><Portrait {...PORTRAIT} /></h1>
  ) : (
    <a class="home" href="/">Home</a>
  )}

  {title !== SITE_TITLE && (
    <nav aria-label="Portfolio categories">
      {CATEGORIES.map(({ slug, title: categoryTitle }) => (
        <a href={`/${slug}/`}>{categoryTitle}</a>
      ))}
    </nav>
  )}
</header>

<style>
  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2em;
  }

  h1 {
    font-size: 1em;
  }

  .home,
  nav a {
    color: var(--theme-sub-text);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5em 1.5em;
  }

  @media (width <= 600px) {
    header {
      flex-direction: column;
      gap: 1.5em;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
